# Copy to .env and fill in. Never commit .env.

# --- Which model reads the receipt -------------------------------------------
# "claude_code" runs headless Claude Code on this machine against its local
# subscription login. "gemini" calls the Gemini API with a key.
# Set a fallback for two independent providers: if one has a bad minute, the
# other answers and the user never sees it.
RECEIPT_PROVIDER=claude_code
RECEIPT_FALLBACK_PROVIDER=gemini

# --- Gemini (needed if either provider above is "gemini") ---------------------
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=45

# --- Claude Code (needed if either provider above is "claude_code") -----------
# Path to the CLI if it isn't on PATH, and an optional model override.
# CLAUDE_BIN=/usr/local/bin/claude
# CLAUDE_MODEL=claude-opus-5

# --- Retry / timeouts --------------------------------------------------------
PROVIDER_MAX_ATTEMPTS=2
PARSE_DEADLINE_S=55

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_EDGE=1600
RATE_LIMIT_PER_HOUR=60
LOG_LEVEL=INFO

# Leave empty in production: Caddy serves the UI and API on one hostname, so
# there is no cross-origin request. Only set for split-origin local dev,
# e.g. CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
