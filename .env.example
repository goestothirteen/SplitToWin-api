# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com

# Optional — defaults shown.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=45
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_EDGE=1600
RATE_LIMIT_PER_HOUR=60
LOG_LEVEL=INFO

# Leave empty in production: Caddy serves the UI and API on one hostname, so
# there is no cross-origin request. Only set this for split-origin local dev,
# e.g. CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
